# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI agent instructions, settings, plugins and skills (local only, never pushed)
/.agents/
/.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/skills-lock.json

# Firebase config, rules and CLI state (local only, never pushed)
/firebase.json
/.firebaserc
/.firebase/
/firestore.rules
/firestore.indexes.json
/storage.rules
/database.rules.json
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
